    <DTS:Executable
      DTS:refId="Package\傳送郵件工作"
      DTS:CreationName="Microsoft.SendMailTask"
      DTS:DelayValidation="True"
      DTS:Description="傳送郵件工作"
      DTS:DTSID="{38338BE0-38B9-4F16-AB8B-C6F2AD961D12}"
      DTS:ExecutableType="Microsoft.SendMailTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="傳送郵件工作"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="CCLine">@[$Package::mail_ToAdmin]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="FileAttachments">@[User::flowReportFile] + "|" +  @[User::detailReportFile]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="FromLine">@[$Package::mail_From]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="MessageSource">@[User::mail_messageSource]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="Subject">@[User::mail_subject]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="ToLine">@[$Package::mail_To]</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SendMailTask:SendMailTaskData
          SendMailTask:SMTPServer="{AAA07245-3276-4E20-A98C-093FFC81D00F}"
          SendMailTask:From="Eslite ODS Test"
          SendMailTask:To="1505003@iisigroup.com"
          SendMailTask:Subject="「ODS」LMS 資料處理完畢_20211223"
          SendMailTask:MessageSource="LMS  資料處理完畢" xmlns:SendMailTask="www.microsoft.com/sqlserver/dts/tasks/sendmailtask">
          <SendMailTask:Attachments
            SendMailTask:FileName="C:\\SSIS_DATA\\template\\stage_flow_template.xlsx|C:\\SSIS_DATA\\template\\stage_detail_template.xlsx" />
        </SendMailTask:SendMailTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\從參數檔USER_PARAMS取得EXCEL檔案範本路徑"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="執行 SQL 工作"
      DTS:DTSID="{2C4C00E4-1C0A-4543-8DBD-EAFF090FCC74}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="從參數檔USER_PARAMS取得EXCEL檔案範本路徑"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{66214BFE-3C93-49AB-B581-7F462381403E}"
          SQLTask:SqlStatementSource="SELECT PARAM_VALUE&#xA;FROM [dbo].[USER_PARAMS]&#xA;WHERE PARAM_NAME = 'TemplateFolderPath';"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::tmpFilePath" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
