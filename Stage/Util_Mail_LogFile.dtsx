    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{1109E87C-87F3-4491-A07C-C31565B12BB3}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;select top 5000 main.SYS_NAME + CASE WHEN main.EKORG &lt;&gt; '' THEN '('+ main.EKORG + ')' ELSE '' END AS SYS_NAME -- 來源系統&#xA;    , main.EXECUTIONID&#xA;    , main.FILE_NAME&#xA;&#x9;, (select [DESC] from  StageETLDB.dbo.PROJECT_PARAMS where PARAM_VALUE = VPI.VERI_PROC_PKEY and TYPE = 1) AS VERI_DESC&#xA;&#x9;, VPI.COLUMN_NAME&#xA;&#x9;, SUBSTRING(VPLFD.RAW_DATA_PK,1,255) AS RAW_DATA_PK&#xA;&#x9;, SUBSTRING(VPLFD.RAW_DATA,1,255) AS RAW_DATA&#xA;&#x9;, VPL.START_VERI_DATE&#xA;&#x9;, VPL.END_VERI_DATE&#xA;from V_FILE_LIST main with(nolock) &#xA;join dbo.VERI_PRESTAGE_LOG VPL on main.FILE_NAME = VPL.FILE_NAME and main.EXECUTIONID = VPL.EXECUTIONID&#xA;join dbo.VERI_PRESTAGE_ITEM VPI on VPL.ITEM_PKEY = VPI.PKEY&#xA;join dbo.VERI_PRESTAGE_LOG_FAIL_DETAIL VPLFD on VPL.PKEY = VPLFD.LOG_PKEY&#xA;where main.SYS_NAME = '&quot;+ @[$Package::sysName] +&quot;' and main.EKORG = '&quot;+ @[$Package::srcEkorg] +&quot;' and main.WORK_DATE = '&quot;+ @[$Package::workDate]   + ( @[$Package::executionID] &gt; 0 ?  &quot;' and main.EXECUTIONID =   &quot;  + (DT_STR, 100, 950) @[$Package::executionID]   :  &quot;'&quot;  )   +&quot;   &#xA;order by ROW_NUMBER() OVER(order by main.EXECUTIONID desc, WORK_DATE desc, main.FILE_NAME, VPI.VERI_PROC_PKEY, VPLFD.PKEY)&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="sqlDetailList">
      <DTS:VariableValue
        DTS:DataType="8">select top 5000 main.SYS_NAME + CASE WHEN main.EKORG &lt;&gt; '' THEN '('+ main.EKORG + ')' ELSE '' END AS SYS_NAME -- 來源系統
    , main.EXECUTIONID
    , main.FILE_NAME
	, (select [DESC] from  StageETLDB.dbo.PROJECT_PARAMS where PARAM_VALUE = VPI.VERI_PROC_PKEY and TYPE = 1) AS VERI_DESC
	, VPI.COLUMN_NAME
	, SUBSTRING(VPLFD.RAW_DATA_PK,1,255) AS RAW_DATA_PK
	, SUBSTRING(VPLFD.RAW_DATA,1,255) AS RAW_DATA
	, VPL.START_VERI_DATE
	, VPL.END_VERI_DATE
from V_FILE_LIST main with(nolock) 
join dbo.VERI_PRESTAGE_LOG VPL on main.FILE_NAME = VPL.FILE_NAME and main.EXECUTIONID = VPL.EXECUTIONID
join dbo.VERI_PRESTAGE_ITEM VPI on VPL.ITEM_PKEY = VPI.PKEY
join dbo.VERI_PRESTAGE_LOG_FAIL_DETAIL VPLFD on VPL.PKEY = VPLFD.LOG_PKEY
where main.SYS_NAME = 'LMS' and main.EKORG = '' and main.WORK_DATE = '2019-12-11'   
order by ROW_NUMBER() OVER(order by main.EXECUTIONID desc, WORK_DATE desc, main.FILE_NAME, VPI.VERI_PROC_PKEY, VPLFD.PKEY)
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{63F49B9C-63DE-4C0B-9949-A7ED2D0007B4}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;select main.SYS_NAME + CASE WHEN main.EKORG &lt;&gt; '' THEN '('+ main.EKORG + ')' ELSE '' END AS SYS_NAME -- 來源系統&#xA;&#x9;, main.TABLE_NAME      -- 資料表名稱&#x9;&#xA;&#x9;, main.EXECUTIONID&#xA;&#x9;, CASE WHEN main.FILE_TYPE = 1 THEN 'CHECKFILE' ELSE '資料檔' END AS FILE_TYPE       -- 檔案類型：0=資料檔案,1=checkfile&#xA;&#x9;, COUNT(1) AS FILE_AMT -- 檔案數量&#xA;&#x9; /* ----- 重複下檔統計 ----- */&#xA;&#x9; , SUM(CASE WHEN exeEndInfo.FILE_STATUS = 11 THEN 1 ELSE 0 END) AS RELOAD_AMT&#xA;&#x9; /* ----- 第一列欄位名稱異常統計 ----- */&#xA;&#x9; , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (12) THEN 1 ELSE 0 END) AS COL_ERR_AMT&#xA;&#x9; /* ----- 異常統計 ----- */&#xA;&#x9; , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (51,61,71) THEN 1 ELSE 0 END) AS ERROR_AMT&#xA;&#x9; /* ----- 寫入結果統計 ----- */&#xA;&#x9; , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (81,82,83,84) AND ISNULL(veriFailCount.FAIL_AMT,0) = 0 THEN 1 ELSE 0 END) AS SUCCESS_AMT&#xA;&#x9; /* ----- 部分資料驗證錯誤無法寫入Stage結果統計 ----- */&#xA;&#x9; , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (81,82,83,84) AND ISNULL(veriFailCount.FAIL_AMT,0) &gt; 0 THEN 1 ELSE 0 END) AS VERI_PRESTAGE_FAIL_AMT&#xA;&#x9; /* ----- CHECKFILE 驗證結果統計 ----- */&#xA;&#x9; , SUM(CASE WHEN FILE_TYPE = 1 THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE IS NULL THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = -4 THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = 4 THEN 1&#xA;&#x9;&#x9;&#x9;&#x9;ELSE 0 END) AS CHECKFILE_VERI_SUCCESS&#xA;&#x9; , SUM(CASE WHEN FILE_TYPE = 1 THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE IS NULL THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = -4 THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = 4 THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;ELSE 1 END) AS CHECKFILE_VERI_FAIL&#xA;&#x9; /* ----- 執行中檔案數量統計 ----- */&#xA;&#x9; , SUM(CASE WHEN exeEndInfo.FILE_STATUS &lt; 10 THEN 1 ELSE 0 END) AS EXE_ING_AMT&#xA;&#x9; /* ----- 未處理檔案數量統計 ----- */&#xA;&#x9; , SUM(CASE WHEN exeEndInfo.FILE_STATUS &gt; 90 THEN 1 ELSE 0 END) AS QUEUE_AMT&#xA;&#x9; /* ----- 檔名不符合Pattern數量統計 ----- */&#xA;&#x9; , 0 AS PATTERN_ERR_AMT&#xA;  from V_FILE_LIST main with(nolock)&#xA;  left join V_FILE_HIS_EXE_END exeEndInfo with(nolock)&#xA;         on main.FILE_NAME = exeEndInfo.FILE_NAME&#xA;&#x9;    and main.CHECK_FILE_NAME = exeEndInfo.CHECK_FILE_NAME&#xA;&#x9;&#x9;and main.EXECUTIONID = exeEndInfo.EXECUTIONID&#xA;  left join V_FILE_VERI_FAIL_COUNT veriFailCount with(nolock)&#xA;         on main.FILE_NAME = veriFailCount.FILE_NAME&#xA;&#x9;&#x9;and main.EXECUTIONID = veriFailCount.EXECUTIONID&#xA;  left join V_FILE_VERI_CHECKFILE veriCheckfile with(nolock)&#xA;&#x9;     on main.FILE_NAME = veriCheckfile.FILE_NAME&#xA;&#x9;    and main.CHECK_FILE_NAME = veriCheckfile.CHECK_FILE_NAME&#xA;&#x9;&#x9;and main.EXECUTIONID = veriCheckfile.EXECUTIONID&#xA; where main.WORK_DATE = '&quot;+ @[$Package::workDate] +&quot;'  and main.SYS_NAME = '&quot;+ @[$Package::sysName] +&quot;' and main.EKORG = '&quot;+ @[$Package::srcEkorg] +&quot;'  and (FILE_TYPE = 1 or (FILE_TYPE = 0 and TABLE_NAME &lt;&gt; '')) &quot;  + ( @[$Package::executionID] &gt; 0 ?  &quot; and main.EXECUTIONID =   &quot;  + (DT_STR, 100, 950) @[$Package::executionID]   :  &quot;&quot;  )  +  &quot;&#xA; group by main.SYS_NAME, main.EKORG, main.TABLE_NAME, main.FILE_TYPE, main.EXECUTIONID&#xA; union&#xA; select SYS_NAME + CASE WHEN EKORG &lt;&gt; '' THEN '('+ EKORG + ')' ELSE '' END AS SYS_NAME -- 來源系統&#xA;&#x9;, '' AS TABLE_NAME      -- 資料表名稱&#x9;&#xA;&#x9;, EXECUTIONID&#xA;&#x9;, '不符合ODS檔名規則' AS FILE_TYPE       -- 檔案類型&#xA;&#x9;, ISNULL(COUNT(1),0) AS FILE_AMT -- 檔案數量&#xA;&#x9; /* ----- 重複下檔統計 ----- */&#xA;&#x9; , 0 AS RELOAD_AMT&#xA;&#x9; /* ----- 第一列欄位名稱異常統計 ----- */&#xA;&#x9; , 0 AS COL_ERR_AMT&#xA;&#x9; /* ----- 異常統計 ----- */&#xA;&#x9; , 0 AS ERROR_AMT&#xA;&#x9; /* ----- 寫入結果統計 ----- */&#xA;&#x9; , 0 AS SUCCESS_AMT&#xA;&#x9; /* ----- 部分資料驗證錯誤無法寫入Stage結果統計 ----- */&#xA;&#x9; , 0 AS VERI_PRESTAGE_FAIL_AMT&#xA;&#x9; /* ----- CHECKFILE 驗證結果統計 ----- */&#xA;&#x9; , 0 AS CHECKFILE_VERI_SUCCESS&#xA;&#x9; , 0 AS CHECKFILE_VERI_FAIL&#xA;&#x9; /* ----- 執行中檔案數量統計 ----- */&#xA;&#x9; , 0 AS EXE_ING_AMT&#xA;&#x9; /* ----- 未處理檔案數量統計 ----- */&#xA;&#x9; , 0 AS QUEUE_AMT&#xA;&#x9; /* ----- 檔名不符合Pattern數量統計 ----- */&#xA;&#x9; , ISNULL(COUNT(1),0) AS PATTERN_ERR_AMT&#xA;   from FILE_REC&#xA;  where WORK_DATE = '&quot;+ @[$Package::workDate] +&quot;'  and SYS_NAME = '&quot;+ @[$Package::sysName] +&quot;' and EKORG = '&quot;+ @[$Package::srcEkorg] +&quot;'  and FILE_STATUS in (13) &quot;  + ( @[$Package::executionID] &gt; 0 ?  &quot; and EXECUTIONID =   &quot;  + (DT_STR, 100, 950) @[$Package::executionID]   :  &quot;&quot;  )  +  &quot;&#xA;  group by WORK_DATE, SYS_NAME, EKORG, EXECUTIONID&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="sqlFlow1Base">
      <DTS:VariableValue
        DTS:DataType="8">select main.SYS_NAME + CASE WHEN main.EKORG &lt;&gt; '' THEN '('+ main.EKORG + ')' ELSE '' END AS SYS_NAME -- 來源系統
	, main.TABLE_NAME      -- 資料表名稱	
	, main.EXECUTIONID
	, CASE WHEN main.FILE_TYPE = 1 THEN 'CHECKFILE' ELSE '資料檔' END AS FILE_TYPE       -- 檔案類型：0=資料檔案,1=checkfile
	, COUNT(1) AS FILE_AMT -- 檔案數量
	 /* ----- 重複下檔統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS = 11 THEN 1 ELSE 0 END) AS RELOAD_AMT
	 /* ----- 第一列欄位名稱異常統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (12) THEN 1 ELSE 0 END) AS COL_ERR_AMT
	 /* ----- 異常統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (51,61,71) THEN 1 ELSE 0 END) AS ERROR_AMT
	 /* ----- 寫入結果統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (81,82,83,84) AND ISNULL(veriFailCount.FAIL_AMT,0) = 0 THEN 1 ELSE 0 END) AS SUCCESS_AMT
	 /* ----- 部分資料驗證錯誤無法寫入Stage結果統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (81,82,83,84) AND ISNULL(veriFailCount.FAIL_AMT,0) &gt; 0 THEN 1 ELSE 0 END) AS VERI_PRESTAGE_FAIL_AMT
	 /* ----- CHECKFILE 驗證結果統計 ----- */
	 , SUM(CASE WHEN FILE_TYPE = 1 THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE IS NULL THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = -4 THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = 4 THEN 1
				ELSE 0 END) AS CHECKFILE_VERI_SUCCESS
	 , SUM(CASE WHEN FILE_TYPE = 1 THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE IS NULL THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = -4 THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = 4 THEN 0
				ELSE 1 END) AS CHECKFILE_VERI_FAIL
	 /* ----- 執行中檔案數量統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS &lt; 10 THEN 1 ELSE 0 END) AS EXE_ING_AMT
	 /* ----- 未處理檔案數量統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS &gt; 90 THEN 1 ELSE 0 END) AS QUEUE_AMT
	 /* ----- 檔名不符合Pattern數量統計 ----- */
	 , 0 AS PATTERN_ERR_AMT
  from V_FILE_LIST main with(nolock)
  left join V_FILE_HIS_EXE_END exeEndInfo with(nolock)
         on main.FILE_NAME = exeEndInfo.FILE_NAME
	    and main.CHECK_FILE_NAME = exeEndInfo.CHECK_FILE_NAME
		and main.EXECUTIONID = exeEndInfo.EXECUTIONID
  left join V_FILE_VERI_FAIL_COUNT veriFailCount with(nolock)
         on main.FILE_NAME = veriFailCount.FILE_NAME
		and main.EXECUTIONID = veriFailCount.EXECUTIONID
  left join V_FILE_VERI_CHECKFILE veriCheckfile with(nolock)
	     on main.FILE_NAME = veriCheckfile.FILE_NAME
	    and main.CHECK_FILE_NAME = veriCheckfile.CHECK_FILE_NAME
		and main.EXECUTIONID = veriCheckfile.EXECUTIONID
 where main.WORK_DATE = '2019-12-11'  and main.SYS_NAME = 'LMS' and main.EKORG = ''  and (FILE_TYPE = 1 or (FILE_TYPE = 0 and TABLE_NAME &lt;&gt; '')) 
 group by main.SYS_NAME, main.EKORG, main.TABLE_NAME, main.FILE_TYPE, main.EXECUTIONID
 union
 select SYS_NAME + CASE WHEN EKORG &lt;&gt; '' THEN '('+ EKORG + ')' ELSE '' END AS SYS_NAME -- 來源系統
	, '' AS TABLE_NAME      -- 資料表名稱	
	, EXECUTIONID
	, '不符合ODS檔名規則' AS FILE_TYPE       -- 檔案類型
	, ISNULL(COUNT(1),0) AS FILE_AMT -- 檔案數量
	 /* ----- 重複下檔統計 ----- */
	 , 0 AS RELOAD_AMT
	 /* ----- 第一列欄位名稱異常統計 ----- */
	 , 0 AS COL_ERR_AMT
	 /* ----- 異常統計 ----- */
	 , 0 AS ERROR_AMT
	 /* ----- 寫入結果統計 ----- */
	 , 0 AS SUCCESS_AMT
	 /* ----- 部分資料驗證錯誤無法寫入Stage結果統計 ----- */
	 , 0 AS VERI_PRESTAGE_FAIL_AMT
	 /* ----- CHECKFILE 驗證結果統計 ----- */
	 , 0 AS CHECKFILE_VERI_SUCCESS
	 , 0 AS CHECKFILE_VERI_FAIL
	 /* ----- 執行中檔案數量統計 ----- */
	 , 0 AS EXE_ING_AMT
	 /* ----- 未處理檔案數量統計 ----- */
	 , 0 AS QUEUE_AMT
	 /* ----- 檔名不符合Pattern數量統計 ----- */
	 , ISNULL(COUNT(1),0) AS PATTERN_ERR_AMT
   from FILE_REC
  where WORK_DATE = '2019-12-11'  and SYS_NAME = 'LMS' and EKORG = ''  and FILE_STATUS in (13) 
  group by WORK_DATE, SYS_NAME, EKORG, EXECUTIONID</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{B22AD5C0-8095-44EA-ABCE-CC066DE76C06}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="@[User::sqlFlow1Base] +&quot; order by SYS_NAME, EXECUTIONID desc,  FILE_TYPE , TABLE_NAME &quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="sqlFlow1List">
      <DTS:VariableValue
        DTS:DataType="8">select main.SYS_NAME + CASE WHEN main.EKORG &lt;&gt; '' THEN '('+ main.EKORG + ')' ELSE '' END AS SYS_NAME -- 來源系統
	, main.TABLE_NAME      -- 資料表名稱	
	, main.EXECUTIONID
	, CASE WHEN main.FILE_TYPE = 1 THEN 'CHECKFILE' ELSE '資料檔' END AS FILE_TYPE       -- 檔案類型：0=資料檔案,1=checkfile
	, COUNT(1) AS FILE_AMT -- 檔案數量
	 /* ----- 重複下檔統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS = 11 THEN 1 ELSE 0 END) AS RELOAD_AMT
	 /* ----- 第一列欄位名稱異常統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (12) THEN 1 ELSE 0 END) AS COL_ERR_AMT
	 /* ----- 異常統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (51,61,71) THEN 1 ELSE 0 END) AS ERROR_AMT
	 /* ----- 寫入結果統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (81,82,83,84) AND ISNULL(veriFailCount.FAIL_AMT,0) = 0 THEN 1 ELSE 0 END) AS SUCCESS_AMT
	 /* ----- 部分資料驗證錯誤無法寫入Stage結果統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS in (81,82,83,84) AND ISNULL(veriFailCount.FAIL_AMT,0) &gt; 0 THEN 1 ELSE 0 END) AS VERI_PRESTAGE_FAIL_AMT
	 /* ----- CHECKFILE 驗證結果統計 ----- */
	 , SUM(CASE WHEN FILE_TYPE = 1 THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE IS NULL THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = -4 THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = 4 THEN 1
				ELSE 0 END) AS CHECKFILE_VERI_SUCCESS
	 , SUM(CASE WHEN FILE_TYPE = 1 THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE IS NULL THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = -4 THEN 0
				WHEN FILE_TYPE = 0 and veriCheckfile.VERI_CHECKFILE = 4 THEN 0
				ELSE 1 END) AS CHECKFILE_VERI_FAIL
	 /* ----- 執行中檔案數量統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS &lt; 10 THEN 1 ELSE 0 END) AS EXE_ING_AMT
	 /* ----- 未處理檔案數量統計 ----- */
	 , SUM(CASE WHEN exeEndInfo.FILE_STATUS &gt; 90 THEN 1 ELSE 0 END) AS QUEUE_AMT
	 /* ----- 檔名不符合Pattern數量統計 ----- */
	 , 0 AS PATTERN_ERR_AMT
  from V_FILE_LIST main with(nolock)
  left join V_FILE_HIS_EXE_END exeEndInfo with(nolock)
         on main.FILE_NAME = exeEndInfo.FILE_NAME
	    and main.CHECK_FILE_NAME = exeEndInfo.CHECK_FILE_NAME
		and main.EXECUTIONID = exeEndInfo.EXECUTIONID
  left join V_FILE_VERI_FAIL_COUNT veriFailCount with(nolock)
         on main.FILE_NAME = veriFailCount.FILE_NAME
		and main.EXECUTIONID = veriFailCount.EXECUTIONID
  left join V_FILE_VERI_CHECKFILE veriCheckfile with(nolock)
	     on main.FILE_NAME = veriCheckfile.FILE_NAME
	    and main.CHECK_FILE_NAME = veriCheckfile.CHECK_FILE_NAME
		and main.EXECUTIONID = veriCheckfile.EXECUTIONID
 where main.WORK_DATE = '2019-12-11'  and main.SYS_NAME = 'LMS' and main.EKORG = ''  and (FILE_TYPE = 1 or (FILE_TYPE = 0 and TABLE_NAME &lt;&gt; '')) 
 group by main.SYS_NAME, main.EKORG, main.TABLE_NAME, main.FILE_TYPE, main.EXECUTIONID
 union
 select SYS_NAME + CASE WHEN EKORG &lt;&gt; '' THEN '('+ EKORG + ')' ELSE '' END AS SYS_NAME -- 來源系統
	, '' AS TABLE_NAME      -- 資料表名稱	
	, EXECUTIONID
	, '不符合ODS檔名規則' AS FILE_TYPE       -- 檔案類型
	, ISNULL(COUNT(1),0) AS FILE_AMT -- 檔案數量
	 /* ----- 重複下檔統計 ----- */
	 , 0 AS RELOAD_AMT
	 /* ----- 第一列欄位名稱異常統計 ----- */
	 , 0 AS COL_ERR_AMT
	 /* ----- 異常統計 ----- */
	 , 0 AS ERROR_AMT
	 /* ----- 寫入結果統計 ----- */
	 , 0 AS SUCCESS_AMT
	 /* ----- 部分資料驗證錯誤無法寫入Stage結果統計 ----- */
	 , 0 AS VERI_PRESTAGE_FAIL_AMT
	 /* ----- CHECKFILE 驗證結果統計 ----- */
	 , 0 AS CHECKFILE_VERI_SUCCESS
	 , 0 AS CHECKFILE_VERI_FAIL
	 /* ----- 執行中檔案數量統計 ----- */
	 , 0 AS EXE_ING_AMT
	 /* ----- 未處理檔案數量統計 ----- */
	 , 0 AS QUEUE_AMT
	 /* ----- 檔名不符合Pattern數量統計 ----- */
	 , ISNULL(COUNT(1),0) AS PATTERN_ERR_AMT
   from FILE_REC
  where WORK_DATE = '2019-12-11'  and SYS_NAME = 'LMS' and EKORG = ''  and FILE_STATUS in (13) 
  group by WORK_DATE, SYS_NAME, EKORG, EXECUTIONID order by SYS_NAME, EXECUTIONID desc,  FILE_TYPE , TABLE_NAME </DTS:VariableValue>
